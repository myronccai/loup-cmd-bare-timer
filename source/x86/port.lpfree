@mode(freestanding)

# x86 port I/O for the timer kernel. Interrupt-safe: one instruction each,
# no state.
#
# Runtime: freestanding, x86_64 board only. Imported by
# main_x86_64.lpfree, so `make build` compiles it only into the bare-metal
# image build/timer-x86_64.elf (`loup build --target freestanding --arch
# x86_64`); the aarch64 image never contains it. It runs when `make boot`
# boots that image on QEMU's pc machine; `make check` type-checks it with
# Stage0.

@interruptSafe
@unsafe("port I/O: writes an x86 I/O port")
pub func outb(port: uint16, value: uint8): void {
    asm { "out dx, al" in: "dx" = port, "al" = value clobbers: [] }
}

@interruptSafe
@unsafe("port I/O: reads an x86 I/O port")
pub func inb(port: uint16): uint8 {
    var value: uint64 = 0;
    asm { "in al, dx" out: value = "=a" in: "dx" = port clobbers: [] }
    return (value & 0xFFu64) as uint8;
}
