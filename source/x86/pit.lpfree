@mode(freestanding)

# The 8254 programmable interval timer. Channel 0 counts down from a
# divisor at 1,193,182 Hz and raises IRQ 0 each time it reaches zero.
#
# Runtime: freestanding, x86_64 board only. Imported by
# main_x86_64.lpfree, so `make build` compiles it only into the bare-metal
# image build/timer-x86_64.elf (`loup build --target freestanding --arch
# x86_64`); the aarch64 image never contains it. It runs when `make boot`
# boots that image on QEMU's pc machine; `make check` type-checks it with
# Stage0.

from x86.port import (outb);

pub const PIT_HZ: uint64 = 1193182u64;

# The divisor for `hz` interrupts a second, rounded to nearest.
pub func pitDivisor(hz: uint64): uint64 {
    return (PIT_HZ + hz / 2u64) / hz;
}

# Channel 0, low byte then high byte, mode 2 (rate generator).
pub func pitStart(divisor: uint64): void {
    outb(0x43u16, 0x34u8);
    outb(0x40u16, (divisor & 0xFFu64) as uint8);
    outb(0x40u16, ((divisor >> 8u64) & 0xFFu64) as uint8);
}
