@mode(freestanding)

# The 8254 programmable interval timer. Channel 0 counts down from a
# divisor at 1,193,182 Hz and raises IRQ 0 each time it reaches zero.
#
# Runtime: freestanding, x86_64 board only. Imported by
# main_x86_64.lpfree, so `make build` compiles it only into the bare-metal
# image build/timer-x86_64.elf (`loup build --target freestanding --arch
# x86_64`); the aarch64 image never contains it. It runs when `make boot`
# boots that image on QEMU's pc machine; `make check` type-checks it with
# Stage0.

from x86.port import (outb);

pub const PIT_HZ: uint64 = 1_193_182u64;

## The divisor for `hz` interrupts a second, rounded to nearest. A const
## func, so the compiler works PIT_DIVISOR out and no division is left in
## the image. (Stage0's const evaluator refuses a parenthesized expression,
## hence the local.)
const func pitDivisor(hz: uint64): uint64 {
    let rounded = PIT_HZ + hz / 2u64;
    return rounded / hz;
}

# 100 is TICK_HZ (timer/app.lpfree): Stage0 cannot evaluate an imported
# constant at compile time, so the rate is written out here.
pub const PIT_DIVISOR: uint64 = pitDivisor(100u64);

## Channel 0, low byte then high byte, mode 2 (rate generator). The command
## and the two divisor bytes are one sequence: an interrupt handler touching
## the PIT in between would leave it half programmed, so interrupts stay
## masked for the three writes and are then restored to what they were.
pub func pitStart(divisor: uint64): void {
    let saved = irqSaveDisable();
    outb(0x43u16, 0x34u8);
    outb(0x40u16, (divisor & 0xFFu64) as uint8);
    outb(0x40u16, ((divisor >> 8u64) & 0xFFu64) as uint8);
    irqRestore(saved);
}
