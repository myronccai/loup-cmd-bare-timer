@mode(freestanding)

# The x86_64 board for `qemu-system-x86_64 -kernel`: the boot headers QEMU
# looks for, the 32-bit entry that switches to long mode, the interrupt
# set-up (IDT, 8259s, PIT, COM1's receive interrupt), and the panic handler.
#
# Runtime: freestanding, x86_64 board only. The entry file of package.lppkg:
# `make build` compiles it, with the x86/ and shared timer/ modules it
# imports, into the bare-metal image build/timer-x86_64.elf (`loup build
# --target freestanding --arch x86_64`, linked at 1 MiB by
# linker/x86_64.ld); there is no operating system, runtime library, heap or
# exceptions. `make boot` boots it on QEMU's pc machine (scripts/qemu.sh),
# waits for heartbeats, presses t, d, u, g, p or q on COM1 and compares the
# transcripts and exit statuses with tests/expected/; `make run` boots it on
# this terminal. `make check` type-checks it with Stage0.
#
# Structure: setup() (IDT, 8259s, PIT, in that order, before interrupts are
# enabled), the CPU hooks the Board carries, kernelMain, the panic handler,
# then the boot headers and _start. The main loop is timer/app.lpfree,
# shared with the aarch64 board.

from appinfo import (STATUS_PANIC);
from timer.app import (TICK_HZ, run);
from timer.board import (Board);
from timer.console import (attach, puts, putDec);
from x86.com1 import (com1Init, com1Put);
from x86.idt import (loadIdt, gateCount);
from x86.pic import (picRemap);
from x86.pit import (PIT_DIVISOR, pitStart);
from x86.qemu import (qemuExit);
from x86.isr import (installHandlers);
from x86.faults import (FAULT_KEYS, TRAP_NAME, trap, provokeFault, printFaultReport);

# IRQ 0 (bit 0) and IRQ 4 (bit 4) enabled on the master; the slave masked.
const MASTER_MASK: uint8 = 0xEEu8;
const SLAVE_MASK: uint8 = 0xFFu8;

func setup(): void {
    installHandlers();
    loadIdt();
    puts("idt: ");
    putDec(gateCount() as uint64);
    puts(" gates installed, loaded with lidt\n");

    picRemap(MASTER_MASK, SLAVE_MASK);
    puts("pic: 8259 pair remapped to vectors 0x20-0x2f; IRQ 0 (PIT) and IRQ 4 (COM1) unmasked\n");

    pitStart(PIT_DIVISOR);
    puts("pit: channel 0 at ");
    putDec(TICK_HZ);
    puts(" Hz (divisor ");
    putDec(PIT_DIVISOR);
    puts(")\n");
}

func enableInterrupts(): void {
    asm { "sti" clobbers: ["memory"] }
}

func idle(): void {
    asm { "hlt" }
}

func exitQemu(status: uint8): void {
    qemuExit(status);
}

func kernelMain(): void {
    com1Init();
    attach(com1Put);
    let board = Board(arch = "x86_64", faultKeys = FAULT_KEYS, setup = setup,
        enableInterrupts = enableInterrupts, idle = idle, trap = trap,
        trapName = TRAP_NAME, pcName = "rip", fault = provokeFault, exit = exitQemu);
    run(board);
    qemuExit(STATUS_PANIC);
}

# ---- Panics -------------------------------------------------------------------

# With `panic = "custom"` in the manifest, every panic lands here: the fault
# handlers reach `unreachable` after recording the fault, and a buffer index
# out of range under `bounds = "trap"` panics too. It masks interrupts and
# writes with the polled, buffer-free console functions.
@panic_handler
func kernelPanic(msg: string, file: string, line: int): noreturn {
    asm { "cli" }
    attach(com1Put);
    puts("PANIC: ");
    puts(msg);
    puts(" at ");
    puts(file);
    puts(":");
    putDec(line as uint64);
    puts("\n");
    printFaultReport();
    qemuExit(STATUS_PANIC);
}

# ---- Boot headers and entry ---------------------------------------------------

# Multiboot2 header: magic, architecture 0 (i386), length, checksum, end tag.
@section(".multiboot")
@naked
@unsafe("naked: data only, never called; the Multiboot2 header")
func multibootHeader(): void {
    asm {
        ".align 8"
        "mb2_start:"
        ".long 0xE85250D6"
        ".long 0"
        ".long mb2_end - mb2_start"
        ".long 0x100000000 - (0xE85250D6 + (mb2_end - mb2_start))"
        ".short 0"
        ".short 0"
        ".long 8"
        "mb2_end:"
    }
}

# Xen PVH note (type 18, XEN_ELFNOTE_PHYS32_ENTRY): where QEMU enters the image.
@section(".note.Xen")
@naked
@unsafe("naked: data only, never called; the PVH entry note")
func pvhNote(): void {
    asm {
        ".align 4"
        ".long 4"
        ".long 4"
        ".long 18"
        ".byte 0x58"
        ".byte 0x65"
        ".byte 0x6e"
        ".byte 0x00"
        ".align 4"
        ".long _start"
    }
}

# QEMU enters here in 32-bit protected mode with paging off and no stack.
# Identity-map the first 1 GiB with 2 MiB pages (tables at 0x70000-0x72FFF),
# enable PAE and long mode, load a flat GDT (0x08 code, 0x10 data), switch to
# the stack the linker script reserves (__stack_top) and call kernelMain.
@entry
@naked
@unsafe("naked: entered by the PVH loader in 32-bit mode with no stack; builds page tables and enters long mode")
@section(".text.boot")
func _start(): void {
    asm {
        ".code32"
        "mov esp, 0x90000"
        # PML4[0] -> the PDPT at 0x71000, PDPT[0] -> the page directory at
        # 0x72000 (low bits 0x3: present, writable). QEMU's RAM starts
        # zeroed, so every other entry of those tables is "not present".
        "mov dword ptr [0x70000], 0x71003"
        "mov dword ptr [0x70004], 0"
        "mov dword ptr [0x71000], 0x72003"
        "mov dword ptr [0x71004], 0"
        # 512 page-directory entries of 2 MiB each (0x83: present,
        # writable, page size): virtual = physical for the first 1 GiB.
        "mov edi, 0x72000"
        "mov eax, 0x83"
        "mov ecx, 512"
        "fill_pd:"
        "mov dword ptr [edi], eax"
        "mov dword ptr [edi+4], 0"
        "add eax, 0x200000"
        "add edi, 8"
        "dec ecx"
        "jnz fill_pd"
        # CR3 = the PML4; CR4.PAE; EFER.LME (MSR 0xC0000080, bit 8); then
        # CR0.PG and CR0.PE together turn paging on, and long mode with it.
        "mov eax, 0x70000"
        "mov cr3, eax"
        "mov eax, cr4"
        "or eax, 0x20"
        "mov cr4, eax"
        "mov ecx, 0xC0000080"
        "rdmsr"
        "or eax, 0x100"
        "wrmsr"
        "mov eax, cr0"
        "or eax, 0x80000001"
        "mov cr0, eax"
        # The CPU still runs 32-bit code until a far jump loads the 64-bit
        # code segment from the GDT.
        "lgdt [gdt_ptr]"
        "jmp 0x08, long_mode"
        ".code64"
        "long_mode:"
        "mov ax, 0x10"
        "mov ds, ax"
        "mov es, ax"
        "mov ss, ax"
        "lea rsp, [rip + __stack_top]"
        "call kernelMain"
        "cli"
        "hlt"
        # The GDT: the null descriptor, 64-bit code (L bit), then data.
        ".align 8"
        "gdt_start:"
        ".quad 0x0000000000000000"
        ".quad 0x00209A0000000000"
        ".quad 0x0000920000000000"
        "gdt_ptr:"
        ".word 23"
        ".long gdt_start"
        clobbers: ["memory"]
    }
}
