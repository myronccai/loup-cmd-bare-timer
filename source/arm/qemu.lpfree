@mode(freestanding)

# Leaving QEMU on aarch64 through semihosting SYS_EXIT.
#
# Runtime: freestanding, aarch64 board only. Imported by
# main_aarch64.lpfree, so `make build` compiles it only into the bare-metal
# image build/timer-aarch64.elf (`loup build --target freestanding --arch
# aarch64 boards/aarch64`); the x86_64 image never contains it. It runs when
# `make boot` boots that image on QEMU's virt machine (Cortex-A53); `make
# check` type-checks it with Stage0 from boards/aarch64.

# Semihosting SYS_EXIT (operation 0x18) with ADP_Stopped_ApplicationExit and
# a status: QEMU, started with -semihosting, exits with that status. The
# trap is `hlt #0xf000`, written as its encoding because the default back
# end's assembler does not know the instruction.
var exitBlock: buffer[uint64, 2];

pub func qemuExit(status: uint8): noreturn {
    exitBlock[0] = 0x20026u64;
    exitBlock[1] = status as uint64;
    let block = addressOf(exitBlock);
    asm {
        "mov w0, #0x18"
        ".inst 0xd45e0000"
        in: "x1" = block
        clobbers: ["x0", "memory"]
    }
    while (true) {
        asm { "wfi" }
    }
}
